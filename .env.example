# ClaimWatch NZ environment — copy to .env and fill in.
# .env is gitignored and NEVER committed (CROSS-CUTTING §4: env + .env, no Vault).

# --- Postgres (dev/CI) ---------------------------------------------------------
# Local dev: the compose database. Local test runs: any scratch database —
# createTestStore wipes whichever database it is pointed at.
DATABASE_URL=postgres://USER:PASSWORD@localhost:5432/claimwatch
# Harness labels database — MUST be a separate database from DATABASE_URL
# (blind rule, HARNESS §2.4); enforced and tested.
LABELS_DATABASE_URL=postgres://USER:PASSWORD@localhost:5432/claimwatch_labels

# --- Site ---
# SITE_STORE=live  (switches verdict/feed pages to the live Postgres reader)
# SITE_REPO_ROOT=../../..
# SITE_REPO_ROOT=../../..

# --- LLM + search providers (ADR-0011) — required for live runs only ---
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GOOGLE_API_KEY=
# BRAVE_API_KEY=
# SERPER_API_KEY=

# --- Observability (ADR-0012) ---
# GRAFANA_OTLP_ENDPOINT=
# GRAFANA_API_TOKEN=
# --- docker compose (dev stack) ------------------------------------------------
# compose reads this file automatically; POSTGRES_USER/PASSWORD are required.
POSTGRES_USER=claimwatch
POSTGRES_PASSWORD=change-me
POSTGRES_DB=claimwatch
POSTGRES_PORT=5432
