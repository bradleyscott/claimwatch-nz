# ClaimWatch NZ environment — copy to .env and fill in.
# .env is gitignored and NEVER committed (CROSS-CUTTING §4: env + .env, no Vault).

# --- Postgres (dev/CI) ---------------------------------------------------------
# Local dev: the compose database. Local test runs: any scratch database —
# createTestStore wipes whichever database it is pointed at.
DATABASE_URL=postgres://USER:PASSWORD@localhost:5432/claimwatch
# Harness labels database — MUST be a separate database from DATABASE_URL
# (blind rule, HARNESS §2.4); enforced and tested.
LABELS_DATABASE_URL=postgres://USER:PASSWORD@localhost:5432/claimwatch_labels

# --- Site ---
# SITE_STORE=live  (switches verdict/feed pages to the live Postgres reader)
# SITE_REPO_ROOT=../../..
# SITE_REPO_ROOT=../../..

# --- LLM + search providers (ADR-0011) — required for live runs only ---
# Keys are demanded lazily: only the provider a selected routing entry names is
# required (a research-only run needs OPENROUTER_API_KEY, a verdict run needs
# ANTHROPIC_API_KEY).
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# OpenRouter — US-hosted aggregator serving the research-tier open weights
# (ADR-0011 rule 3). Must be OpenRouter's own inference endpoint, never a
# passthrough to an origin operator's API.
# OPENROUTER_API_KEY=
# Decision transport (ADR-0024). Comma-separated triage roles to route through the
# System One decision model. Unset takes the default (`triage-checkability`); an
# empty value turns the routing off. `triage-speakership` is not routed — the
# labelled set puts it at 55.7% accuracy, so it stays generative.
# DECISION_ROLES=

# --- Research budget (ADR-0026) ---

# The research loop's budget for one claim, in USD. The loop keeps researching
# until its model spend reaches this, so the budget — not a fixed turn count —
# decides how long to keep looking. Unset takes the pipeline default (0.25).
# RESEARCH_BUDGET_USD=
# GOOGLE_API_KEY=
# BRAVE_API_KEY=
# SERPER_API_KEY=

# --- Observability (ADR-0012) ---
# GRAFANA_OTLP_ENDPOINT=
# GRAFANA_API_TOKEN=
# --- docker compose (dev stack) ------------------------------------------------
# compose reads this file automatically; POSTGRES_USER/PASSWORD are required.
POSTGRES_USER=claimwatch
POSTGRES_PASSWORD=change-me
POSTGRES_DB=claimwatch
POSTGRES_PORT=5432
