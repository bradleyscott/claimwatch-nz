{
  "name": "claimwatch",
  "private": true,
  "packageManager": "pnpm@11.8.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "tools/*",
    "ops"
  ],
  "scripts": {
    "typecheck": "pnpm -r run typecheck",
    "test": "vitest run",
    "lint": "biome check .",
    "format": "biome check --write .",
    "db:migrate": "pnpm --filter @cw/store db:migrate",
    "db:migrate:labels": "pnpm --filter @cw/harness db:migrate",
    "db:generate": "pnpm --filter @cw/store db:generate",
    "db:generate:labels": "pnpm --filter @cw/harness db:generate"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.13",
    "drizzle-orm": "0.45.2",
    "tsx": "^4.19.0",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vitest": "5.0.0"
  }
}
