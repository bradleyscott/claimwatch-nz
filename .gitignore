# Local test-run databases (SQL scratch files) — never committed.
scratch/
*.sql
# ...but the schema's SQL is not scratch. Drizzle's migrator reads the harness
# labels chain, and the store applies its own `packages/store/sql/*.sql` after
# `pushSchema` (zero-migration), so a clone without these cannot migrate at all.
# The blanket rule above silently swallowed 0000–0003 until this was caught — and
# it then did it again to the harness labels chain, and again to the store's
# zero-migration seeds, hence the explicit negations.
!packages/*/drizzle/*.sql
!packages/store/sql/*.sql

# Environment files (CROSS-CUTTING §4) — .env.example is the template.
.env
.env.local
apps/site/.env
apps/*/.env

# Node
node_modules/

# Build
dist/
.next/

# Named and tested databases (ADR-0004)
data/

# Editor
.idea/
.vscode/

# macOS
.DS_Store
