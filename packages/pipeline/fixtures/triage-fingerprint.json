      "domain": "crime",
      "temporal": "since 2017",
      "quantity": "30 percent",
      "source": "Q+A"
    },
    "b": {
      "core": "Crime is up 30% since 2017.",
      "claimant": "CHL",
      "domain": "crime",
      "temporal": "since 2017",
      "quantity": "30 percent",
      "source": "Q+A"
    },
    "expectSameKey": true
  },
